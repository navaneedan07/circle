# Circle configuration.
#
# Copy to .env and edit. Everything here is optional: with no .env at all,
# Circle runs on localhost with no access key, which is the right setting for
# one person on their own machine.

# ---------------------------------------------------------------- database
# Your archive lives here. Keep it on this machine if you can: a hosted
# database means your conversations are stored on someone else's servers.
DATABASE_URL=mongodb://localhost:27017
DATABASE_NAME=circle
# Only for MongoDB Atlas, which also needs a vector search index named by
# ATLAS_VECTOR_INDEX. Leave false to keep everything local.
MONGO_ATLAS=false

# ---------------------------------------------------------------- local AI
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Smaller and faster on a CPU, worse answers. Try gemma3:1b on a laptop.
# OLLAMA_MODEL=gemma3:1b

# ---------------------------------------------------------------- watching
# Leave empty to use ./Circle-data. Managed folders get reorganized into
# processed/; folders you point at are read in place and never touched.
IMPORT_ROOT=
# Extra folders, comma separated. Your own folders (Drive, Downloads, a USB
# backup) are only ever read.
WATCH_ROOTS=

# ---------------------------------------------------------------- access
# Circle holds one person's entire message history and can permanently delete
# records. On localhost that is safe. The moment this machine is reachable from
# somewhere else (a tunnel, another device on the network), set ACCESS_KEY.
#
# With no key, remote callers are refused outright rather than served an open
# archive. With a key, callers must send it in the X-Circle-Key header.
ACCESS_KEY=
ALLOW_REMOTE=false

# Origins allowed to call this API from a browser. Only needed when the web UI
# is hosted separately from the backend, e.g. the Render static site.
# CORS_ORIGINS=https://circle-ui.onrender.com

# ---------------------------------------------------------------- server
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# ---------------------------------------------------------------- optional
# Local speech-to-text for voice memos.
STT_PROVIDER=local-whisper
WHISPER_MODEL=base

# Leave blank. Circle is private by default; setting this sends error metadata
# (never message content) to a third party.
SENTRY_DSN=
SENTRY_ENABLED=false

# Read answers aloud. Setting a key sends the answer text to ElevenLabs.
ELEVENLABS_API_KEY=